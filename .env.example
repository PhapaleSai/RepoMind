# Insforge Postgres connection string (Project settings -> Database -> Connection string).
# Used directly (via `pg`) for pgvector similarity search and migrations.
INSFORGE_DATABASE_URL=postgres://user:password@host:port/database

# Optional: raises GitHub API rate limits for ingestion (unauthenticated works fine for small repos).
GITHUB_TOKEN=

# Used server-side only, to turn code chunks and questions into embeddings
# (Cohere embed-english-v3.0, free trial tier, no credit card). Get one at
# dashboard.cohere.com/api-keys.
COHERE_API_KEY=

# Chat itself is still bring-your-own-key in the browser UI (defaults to Groq too, but
# any OpenAI-compatible provider works) — no separate server-side chat key needed.

# Encrypts the GitHub OAuth token cookie (AES-256-GCM). Any random 32+ byte hex string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Only needed for private-repo support. Create a GitHub OAuth App at
# github.com/settings/developers with callback URL <your-deployed-url>/api/auth/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Authenticates the daily cleanup cron job (see vercel.json + app/api/cron/cleanup) that
# removes repositories unused for 24h, keeping DB storage within the free tier. Any
# random string; Vercel automatically sends it as the cron request's Authorization header
# once set as a project env var. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
